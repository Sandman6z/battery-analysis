/* ============================================
   Battery Analyzer - Unified UI Stylesheet
   Version: 6.0 - Warm beige borderless theme
   Author: UI Team
   Date: 2026-05-15

   Features:
   - Unified style management for all UI components
   - Matplotlib QtAgg component support
   - Modern battery viewer component support
   - Main window component support
   - Style conflict prevention
   ============================================ */


/* ============================================
   Base styles
   ============================================ */

QMainWindow, QWidget {
    background-color: #f5f0e8;
    color: #3d3229;
    font-family: 'Microsoft YaHei', 'SimHei', sans-serif;
}


/* ============================================
   Frame styles
   ============================================ */

QFrame {
    border: none;
    background-color: transparent;
}

QFrame[frameShadow="Sunken"] {
    border: none;
    background-color: transparent;
}


/* ============================================
   Group box styles
   ============================================ */

QGroupBox {
    font-weight: bold;
    border: 1px solid #d6cec4;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 8px 0 8px;
    color: #8a7a6a;
}


/* ============================================
   Control panel
   ============================================ */

#control_frame {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #faf7f2,
        stop:1 #f5f0e8);
    border-radius: 12px;
    border: 1px solid #e0d8cc;
    padding: 2px;
}


/* ============================================
   Input controls - borderless warm beige
   ============================================ */

/* QLineEdit */
QLineEdit {
    border: none;
    border-radius: 8px;
    padding: 5px 8px;
    background-color: #ede9e3;
    color: #3d3229;
    font-size: 11px;
}

QLineEdit:hover {
    background-color: #e5e0d8;
}

QLineEdit:focus {
    border: 2px solid #27ae60;
    background-color: #ffffff;
    padding: 3px 6px;
    outline: none;
}

QLineEdit[readOnly="true"] {
    background-color: #f0ebe3;
    border: 1px solid #e0d8cc;
    color: #8a7a6a;
}

/* QComboBox - same borderless warm beige pattern */
QComboBox {
    border: none;
    border-radius: 8px;
    padding: 5px 8px;
    background-color: #ede9e3;
    color: #3d3229;
    min-width: 80px;
    font-size: 11px;
}

QComboBox:hover {
    background-color: #e5e0d8;
}

QComboBox:focus, QComboBox:on {
    border: 2px solid #27ae60;
    background-color: #ffffff;
    padding: 3px 6px;
}

QComboBox::drop-down {
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(chevron-down.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #faf7f2;
    border: 1px solid #e0d8cc;
    border-radius: 6px;
    selection-background-color: #27ae60;
    selection-color: white;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 3px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #e0d8cc;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #27ae60;
    color: white;
}

/* QSpinBox - borderless warm beige pattern */
QSpinBox {
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 4px 8px;
    background-color: #ede9e3;
    color: #3d3229;
    font-size: 11px;
}

QSpinBox:hover {
    background-color: #e5e0d8;
}

QSpinBox:focus {
    border: 2px solid #27ae60;
    background-color: #ffffff;
    padding: 3px 7px;
}

QSpinBox::up-button, QSpinBox::down-button {
    border: none;
    background: transparent;
    width: 20px;
}

QSpinBox::up-arrow {
    image: url(chevron-up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow {
    image: url(chevron-down.svg);
    width: 10px;
    height: 10px;
}

/* QTextEdit */
QTextEdit {
    background-color: #f5f0e8;
    border: 1px solid #e0d8cc;
    border-radius: 8px;
    padding: 4px;
    font-size: 11px;
}

QTextEdit[data-style="info"] {
    background-color: #faf7f2;
    border: 1px solid #e0d8cc;
    border-radius: 8px;
    padding: 5px;
}


/* ============================================
   Button styles
   ============================================ */

/* Base push button - borderless warm beige */
QPushButton {
    border: none;
    border-radius: 8px;
    padding: 4px 10px;
    background-color: #ede9e3;
    color: #3d3229;
    font-weight: 500;
    font-size: 10px;
}

QPushButton:hover {
    background-color: #e5e0d8;
}

QPushButton:pressed {
    background-color: #e0d8cc;
}

QPushButton:disabled {
    background-color: #f5f0e8;
    color: #adb5bd;
}

/* Run button - green gradient */
#pushButton_Run {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #27ae60,
        stop:1 #2ecc71);
    border: 1px solid #27ae60;
    border-radius: 8px;
    color: white;
    font-size: 20px;
}

#pushButton_Run:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2ecc71,
        stop:1 #58d68d);
    border-color: #2ecc71;
    color: white;
}

#pushButton_Run:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #27ae60,
        stop:1 #1e8449);
    border-color: #1e8449;
    color: white;
}

/* Browse/Open button - blue gradient */
QPushButton[text="Open"],
QPushButton[text="浏览"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3498db,
        stop:1 #5dade2);
    border: 1px solid #3498db;
    border-radius: 8px;
    color: white;
    padding: 4px 16px;
    font-size: 11px;
}

QPushButton[text="Open"]:hover,
QPushButton[text="浏览"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5dade2,
        stop:1 #85c1e9);
    border-color: #5dade2;
}

/* Gradient button styles by type (Enhanced style) */
QPushButton[button-type="load"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #27ae60,
        stop:1 #2ecc71);
    border: 1px solid #27ae60;
    border-radius: 8px;
    color: white;
}

QPushButton[button-type="load"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2ecc71,
        stop:1 #58d68d);
    border-color: #2ecc71;
    color: white;
}

QPushButton[button-type="load"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #27ae60,
        stop:1 #1e8449);
    border-color: #1e8449;
    color: white;
}

QPushButton[button-type="apply"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f39c12,
        stop:1 #f1c40f);
    border: 1px solid #f39c12;
    border-radius: 8px;
    color: white;
}

QPushButton[button-type="apply"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f1c40f,
        stop:1 #f7dc6f);
    border-color: #f1c40f;
    color: white;
}

QPushButton[button-type="apply"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e67e22,
        stop:1 #f39c12);
    border-color: #e67e22;
    color: white;
}

QPushButton[button-type="analyze"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3498db,
        stop:1 #5dade2);
    border: 1px solid #3498db;
    border-radius: 8px;
    color: white;
}

QPushButton[button-type="analyze"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5dade2,
        stop:1 #85c1e9);
    border-color: #5dade2;
    color: white;
}

QPushButton[button-type="analyze"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2980b9,
        stop:1 #3498db);
    border-color: #2980b9;
    color: white;
}

/* Gradient button styles by data-action (Modern style compatibility) */
QPushButton[data-action="load"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #27ae60,
        stop:1 #2ecc71);
    border: 1px solid #27ae60;
    border-radius: 8px;
    color: white;
}

QPushButton[data-action="load"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2ecc71,
        stop:1 #58d68d);
    border-color: #2ecc71;
    color: white;
}

QPushButton[data-action="apply"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f39c12,
        stop:1 #f1c40f);
    border: 1px solid #f39c12;
    border-radius: 8px;
    color: white;
}

QPushButton[data-action="apply"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f1c40f,
        stop:1 #f7dc6f);
    border-color: #f1c40f;
    color: white;
}

QPushButton[data-action="analyze"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3498db,
        stop:1 #5dade2);
    border: 1px solid #3498db;
    border-radius: 8px;
    color: white;
}

QPushButton[data-action="analyze"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5dade2,
        stop:1 #85c1e9);
    border-color: #5dade2;
    color: white;
}


/* ============================================
   Label styles
   ============================================ */

QLabel {
    font-size: 11px;
    color: #8a7a6a;
    border: none;
    outline: none;
}

QLabel[data-type="title"] {
    font-weight: bold;
    font-size: 12px;
    color: #3d3229;
    border: none;
    outline: none;
}

QLabel[data-status="warning"] {
    color: #dc3545;
    font-weight: bold;
    border: none;
    outline: none;
}

QLabel[data-status="success"] {
    color: #28a745;
    font-weight: bold;
    border: none;
    outline: none;
}

QLabel[data-status="info"] {
    color: #17a2b8;
    font-weight: bold;
    border: none;
    outline: none;
}


/* ============================================
   Table styles
   ============================================ */

QTableWidget {
    border: none;
    background-color: #f5f0e8;
    gridline-color: #e0d8cc;
}

QTableWidget::header {
    background-color: #f5f0e8;
    color: #8a7a6a;
    font-weight: bold;
    font-size: 11px;
    height: 36px;
}

QTableWidget::horizontalHeader {
    border-bottom: 2px solid #e0d8cc;
}

QTableWidget::verticalHeader {
    border-right: 1px solid #e0d8cc;
    width: 30px;
}

QTableWidget::item {
    padding: 8px 12px;
    color: #8a7a6a;
    font-size: 10px;
}

QTableWidget::item:selected {
    background-color: #27ae60;
    color: white;
}


/* ============================================
   Progress bar styles
   ============================================ */

QProgressBar {
    border: none;
    border-radius: 0px;
    text-align: center;
    background-color: #e0d8cc;
    height: 14px;
    font-weight: 600;
    font-size: 11px;
    color: #8a7a6a;
}

QProgressBar::chunk {
    background-color: #27ae60;
    border-radius: 0px;
}


/* ============================================
   Status bar styles
   ============================================ */

QStatusBar {
    background-color: #faf7f2;
    border-top: 1px solid #e0d8cc;
    color: #8a7a6a;
    font-size: 10px;
    padding: 4px 12px;
}


/* ============================================
   Menu system styles
   ============================================ */

QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f5f0e8,
        stop:1 #f5f0e8);
    border-bottom: 1px solid #e0d8cc;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 4px;
    color: #8a7a6a;
    font-weight: 500;
    font-size: 12px;
}

QMenuBar::item:hover {
    background-color: #e0d8cc;
    color: #8a7a6a;
}

QMenuBar::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #27ae60,
        stop:1 #2ecc71);
    color: white;
}

QMenu {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f5f0e8,
        stop:1 #f5f0e8);
    border: 1px solid #e0d8cc;
    border-radius: 6px;
    padding: 5px;
    min-width: 150px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 3px;
    color: #8a7a6a;
}

QMenu::item:hover {
    background-color: #27ae60;
    color: white;
}

QMenu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #27ae60,
        stop:1 #2ecc71);
    color: white;
}

QMenu::separator {
    height: 1px;
    background-color: #e0d8cc;
    margin: 4px 8px;
}


/* ============================================
   Toolbar styles
   ============================================ */

/* General toolbar */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f5f0e8,
        stop:1 #f5f0e8);
    border: 1px solid #e0d8cc;
    border-radius: 8px;
    spacing: 4px;
    padding: 4px;
}

QToolBar QToolButton {
    background-color: #faf7f2;
    border: 1px solid #e0d8cc;
    border-radius: 4px;
    padding: 5px;
    min-width: 30px;
    min-height: 30px;
    font-size: 16px;
    color: #8a7a6a;
}

QToolBar QToolButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #27ae60,
        stop:1 #2ecc71);
    color: white;
    border-color: #27ae60;
}

QToolBar QToolButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2980b9,
        stop:1 #21618c);
    color: white;
    border-color: #2980b9;
}

/* Matplotlib NavigationToolbar */
QToolBar[objectName="NavigationToolbar"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #faf7f2,
        stop:1 #f5f0e8);
    border: 1px solid #e0d8cc;
    border-radius: 10px;
    spacing: 6px;
    padding: 6px;
}


/* ============================================
   Tab widget styles
   ============================================ */

QTabWidget::pane {
    border: 2px solid #27ae60;
    border-radius: 12px;
    background-color: #f5f0e8;
    margin: 2px;
}

QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f5f0e8,
        stop:1 #ede9e3);
    color: #3d3229;
    padding: 12px 20px;
    margin-right: 3px;
    margin-top: 3px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border: 1px solid #e0d8cc;
    border-bottom: none;
    font-weight: bold;
    font-size: 11px;
    min-width: 100px;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #27ae60,
        stop:1 #2ecc71);
    color: white;
    border-color: #27ae60;
    border-bottom: 2px solid #27ae60;
}

QTabBar::tab:hover:!selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e0d8cc,
        stop:1 #f5f0e8);
    color: #8a7a6a;
}


/* ============================================
   Checkbox styles
   ============================================ */

QCheckBox {
    spacing: 8px;
    font-size: 11px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 2px solid #e0d8cc;
    background-color: #faf7f2;
}

QCheckBox::indicator:checked {
    background-color: #27ae60;
    border-color: #27ae60;
}

QCheckBox::indicator:checked:hover {
    background-color: #2ecc71;
}


/* ============================================
   Progress dialog styles
   ============================================ */

#progress_dialog {
    background-color: #faf7f2;
    border: 1px solid #e0d8cc;
    border-radius: 16px;
    font-family: 'Microsoft YaHei', 'SimHei', sans-serif;
}

#progress_status_label {
    font-size: 13px;
    color: #3d3229;
    font-weight: 500;
    padding: 4px 0px;
}

#progress_bar {
    border: none;
    border-radius: 14px;
    text-align: center;
    background-color: #ede9e3;
    height: 28px;
    font-weight: bold;
    font-size: 12px;
    color: #ffffff;
    padding: 0px;
}

#progress_bar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3498db,
        stop:0.3 #2ecc71,
        stop:0.6 #27ae60,
        stop:1 #1abc9c);
    border-radius: 14px;
}

#cancel_button {
    background-color: #faf7f2;
    border: 1.5px solid #e74c3c;
    border-radius: 8px;
    padding: 6px 20px;
    color: #e74c3c;
    font-weight: 600;
    font-size: 12px;
    min-height: 32px;
    min-width: 100px;
}

#cancel_button:hover {
    background-color: #e74c3c;
    border-color: #c0392b;
    color: #ffffff;
}

#cancel_button:pressed {
    background-color: #c0392b;
    border-color: #a93226;
    color: #ffffff;
}


/* ============================================
   Matplotlib / Figure styles
   ============================================ */

FigureCanvasQTAgg {
    background-color: #f5f0e8;
    border: 1px solid #e0d8cc;
    border-radius: 8px;
}

QMdiSubWindow {
    background-color: #f5f0e8;
    border: 2px solid #27ae60;
    border-radius: 10px;
}

QMdiSubWindow QWidget {
    background-color: #f5f0e8;
}

Figure {
    background-color: #f5f0e8;
    border-radius: 8px;
}

Axes {
    background-color: #f5f0e8;
}

Text {
    font-family: 'Microsoft YaHei', 'SimHei', sans-serif;
}


/* ============================================
   Dialog styles
   ============================================ */

QDialog {
    background-color: #f5f0e8;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
    padding: 8px 16px;
}


/* ============================================
   Scrollbar styles
   ============================================ */

QScrollBar:vertical {
    background-color: #f5f0e8;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #e0d8cc;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #d5cdc0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}

/* ── 水平滚动条 ── */

QScrollBar:horizontal {
    background-color: #e0d8cc;
    height: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #c0b8a8;
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #d5cdc0;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

/* ── Tooltip ── */

QToolTip {
    background-color: #3d3229;
    color: #ffffff;
    border: 1px solid #27ae60;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}
